#!/usr/bin/env bash
#
# Clone & install:
#
#   git clone --recursive https://github.com/leekyungmoon/dotfiles.git ~/.dotfiles && ~/.dotfiles/install
#
# Installs the ~/.dotfiles checkout as it is: local edits and commits stay,
# nothing is pulled or moved. This runs etc/install there, which does the same
# checks as the one-liner, then install.py (options go to it, e.g. ./install
# --no-gui), then, when it installed, starts a new login shell. Anywhere else
# it changes nothing and prints what to run instead.
#
# It runs under macOS's /bin/bash 3.2 and BSD tools, too.

# Started as 'sh install' or 'zsh install': run it with bash.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi

set -eu
CDPATH=

# bash's own BASH_SOURCE is an array; one imported from the environment is a
# plain exported string ('declare -x'). The bash 3.2 spelling of
# [[ "${BASH_SOURCE@a}" == *a* ]] (bash 4.4 and newer only).
_bash_source_is_own() {
  local decl flags
  decl="$(declare -p BASH_SOURCE 2> /dev/null)" || return 1
  flags="${decl#declare -}"
  flags="${flags%% *}"
  [[ "$flags" == *a* ]]
}

if ! _bash_source_is_own; then
  echo "BASH_SOURCE is set in the environment; unset it and rerun." >&2
  exit 2
fi

dest="${HOME}/.dotfiles"

# Unless this very file is the checkout's own ./install: the same file
# (device and inode) through any symlink or spelling (readlink -e is GNU
# only).
if [[ ! "${BASH_SOURCE[0]:-}" -ef "$dest/install" ]]; then
  if [[ ! -e "$dest" ]]; then
    echo "Clone & install into ~/.dotfiles:" >&2
    echo "  git clone --recursive https://github.com/leekyungmoon/dotfiles.git ~/.dotfiles && ~/.dotfiles/install" >&2
  elif [[ -f "$dest/install" && -f "$dest/etc/install" && -d "$dest/installer" ]]; then
    echo "Install the checkout at ~/.dotfiles:" >&2
    echo "  ~/.dotfiles/install" >&2
  else
    echo "~/.dotfiles is another checkout. The one-liner moves it aside (nothing is deleted) and installs:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/leekyungmoon/dotfiles/HEAD/etc/install | bash" >&2
  fi
  exit 2
fi

exec bash "$dest/etc/install" "$@"
