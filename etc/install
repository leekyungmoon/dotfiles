#!/bin/bash

# Usage:
#   curl -fsSL https://raw.githubusercontent.com/leekyungmoon/dotfiles/HEAD/etc/install | bash
#   wget -qO- https://raw.githubusercontent.com/leekyungmoon/dotfiles/HEAD/etc/install | bash
#
# Options after 'bash -s --' go to install.py, e.g.
#   curl -fsSL .../etc/install | bash -s -- --no-gui
#
# Clones the repository into ~/.dotfiles (like upstream) and runs install.py
# there. An existing ~/.dotfiles that is a clean clone of this repository is
# fast-forwarded; anything else there is moved aside, never deleted, to
#   ${XDG_STATE_HOME:-~/.local/state}/personal-dotfiles/backups/pre-install-<UTC>/dotfiles
# but only after the new clone (made in a temporary sibling) has succeeded,
# so a failed clone leaves the existing checkout where it was.
#
# Environment: DOTFILES_REPO_URL (clone source), DOTFILES_REF (branch, tag or
# commit), DOTFILES_EXEC_SHELL=0 (do not start the new shell at the end).
#
# When install.py succeeds and the one-liner runs in a terminal, the script
# ends like oh-my-zsh's installer: it execs a login zsh (or, without zsh on
# PATH, the passwd login shell) on that terminal, so the terminal is on the
# new setup at once (open zsh shells reload themselves before their next
# command, see zsh/zsh.d/dotfiles-reload.zsh).
#
# Everything runs inside main(), which is called on the very last line, so a
# truncated download never runs a partial script.

main() {
  set -e

  local repo_url="${DOTFILES_REPO_URL:-https://github.com/leekyungmoon/dotfiles.git}"
  local ref="${DOTFILES_REF:-}"
  local dest="${HOME}/.dotfiles"

  cat <<EOF
   @leekyungmoon's          ███████╗██╗██╗     ███████╗███████╗
   ██████╗  █████╗ ████████╗██╔════╝██║██║     ██╔════╝██╔════╝
   ██╔══██╗██╔══██╗╚══██╔══╝█████╗  ██║██║     █████╗  ███████╗
   ██║  ██║██║  ██║   ██║   ██╔══╝  ██║██║     ██╔══╝  ╚════██║
   ██████╔╝╚█████╔╝   ██║   ██║     ██║███████╗███████╗███████║
   ╚═════╝  ╚═════╝   ╚═╝   ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝
EOF

  _die() { echo "ERROR: $*" >&2; exit 1; }
  # A clone that did not make it into place is removed on any exit.
  _pending_clone=""
  # Stop tracing first, so the cleanup does not echo its own internals.
  trap '{ set +x; } 2> /dev/null; _discard_pending_clone' EXIT

  # Refuse root: everything is installed for (and owned by) your own user.
  # _DOTFILES_INSTALL_SIMULATE_ROOT can only add this refusal (tests).
  if [[ "${EUID:-$(id -u)}" -eq 0 || "${_DOTFILES_INSTALL_SIMULATE_ROOT:-0}" == 1 ]]; then
    _die "do not run this as root (or with sudo). Run it as your normal user; sudo is asked only for apt."
  fi

  # Check the platform: Ubuntu 22.04/24.04 on amd64/arm64.
  [[ -r /etc/os-release ]] || _die "cannot read /etc/os-release"
  local os_id os_version arch
  os_id="$(. /etc/os-release && echo "${ID:-}")"
  os_version="$(. /etc/os-release && echo "${VERSION_ID:-}")"
  [[ "$os_id" == ubuntu ]] || _die "unsupported distribution '$os_id'; Ubuntu 22.04 or 24.04 is required."
  case "$os_version" in
    22.04 | 24.04) ;;
    *) _die "unsupported Ubuntu release '$os_version'; 22.04 or 24.04 is required." ;;
  esac
  arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
  case "$arch" in
    amd64 | x86_64 | arm64 | aarch64) ;;
    *) _die "unsupported architecture '$arch'; amd64 or arm64 is required." ;;
  esac

  # Check minimal dependencies; install the missing ones with sudo apt-get.
  local missing=()
  command -v git &> /dev/null || missing+=(git)
  if ! command -v curl &> /dev/null && ! command -v wget &> /dev/null; then missing+=(curl); fi
  command -v python3 &> /dev/null || missing+=(python3)
  [[ -e /etc/ssl/certs/ca-certificates.crt ]] || missing+=(ca-certificates)
  if (( ${#missing[@]} > 0 )); then
    echo "Missing: ${missing[*]}. Installing git curl ca-certificates python3 with sudo apt-get."
    echo "Please type your password if sudo asks for it."
    command -v sudo &> /dev/null || _die "sudo not found. Ask an administrator to run: apt-get install -y git curl ca-certificates python3"
    local tty_in=/dev/null
    if [[ -t 0 ]]; then tty_in=/dev/stdin; elif { : < /dev/tty; } 2> /dev/null; then tty_in=/dev/tty; fi
    { sudo apt-get update && sudo apt-get install -y git curl ca-certificates python3; } < "$tty_in" \
      || _die "sudo apt-get install failed (sudo refused or apt unavailable). Install git curl ca-certificates python3 and rerun."
  fi
  python3 -c 'import sys; sys.exit(sys.version_info < (3, 10))' \
    || _die "python3 3.10 or newer is required."

  local state_home="${XDG_STATE_HOME:-}"
  [[ "$state_home" == /* ]] || state_home="${HOME}/.local/state"

  # stdin of 'curl | bash' is this script; give install.py the terminal.
  local tty_in=""
  if [[ -t 0 ]]; then tty_in=/dev/stdin; elif { : < /dev/tty; } 2> /dev/null; then tty_in=/dev/tty; fi

  # What to do with an existing "$dest": a clean clone of this repository
  # is fast-forwarded; anything else is moved aside (never deleted).
  local existing=none
  if [[ -e "$dest" || -L "$dest" ]]; then
    existing=move
    if [[ -d "$dest" && ! -L "$dest" && -e "$dest/.git" ]] \
        && [[ "$(git -C "$dest" rev-parse --show-toplevel 2> /dev/null)" == "$(cd "$dest" && pwd -P)" ]]; then
      local origin
      origin="$(git -C "$dest" remote get-url origin 2> /dev/null || true)"
      if [[ -n "$origin" && "$(_normalize_url "$origin")" == "$(_normalize_url "$repo_url")" ]] \
          && [[ -z "$(git -C "$dest" status --porcelain --untracked-files=no 2> /dev/null)" ]]; then
        existing=pull
      fi
    fi
  fi
  local backup=""
  if [[ "$existing" == move ]]; then
    backup="${state_home}/personal-dotfiles/backups/pre-install-$(date -u +%Y%m%dT%H%M%SZ)"
    local n=0 candidate="$backup"
    while [[ -e "$candidate" || -L "$candidate" ]]; do n=$((n + 1)); candidate="${backup}-${n}"; done
    backup="$candidate"
  fi

  set -x

  # ============================================================================

  cd ~

  if [[ "$existing" == pull ]]; then
    if [[ -n "$ref" ]]; then
      git -C "$dest" fetch origin
      git -C "$dest" checkout "$ref"
    fi
    if git -C "$dest" symbolic-ref -q HEAD > /dev/null; then
      git -C "$dest" pull --ff-only \
        || _die "cannot fast-forward $dest (local commits?); resolve it there, then rerun."
    fi
    git -C "$dest" submodule update --init --recursive --jobs 8
  else
    # Clone and check out into a new sibling first; only a complete checkout
    # replaces "$dest". Until then an existing "$dest" is not touched, and a
    # failed clone leaves nothing behind but the error.
    local fresh="${dest}.new-$(date -u +%Y%m%dT%H%M%SZ)-$$"
    [[ ! -e "$fresh" && ! -L "$fresh" ]] || _die "$fresh already exists; remove it and rerun."
    _pending_clone="$fresh"
    local clone_args=(--recursive -j8)
    if [[ -n "$ref" && ! "$ref" =~ ^[0-9a-f]{40}$ ]]; then clone_args+=(--branch "$ref"); fi
    git clone "${clone_args[@]}" "$repo_url" "$fresh" \
      || _die "git clone of $repo_url failed; nothing was installed.$(_left_alone "$dest")"
    if [[ "$ref" =~ ^[0-9a-f]{40}$ ]]; then
      git -C "$fresh" checkout --detach "$ref" \
        && git -C "$fresh" submodule update --init --recursive --jobs 8 \
        || _die "cannot check out $ref; nothing was installed.$(_left_alone "$dest")"
    fi
    if [[ "$existing" == move ]]; then
      (umask 077 && mkdir -p "$backup") \
        && mv -- "$dest" "$backup/dotfiles" \
        || _die "cannot move $dest to $backup/dotfiles; nothing was installed."
      { set +x; } 2> /dev/null
      echo "Moved the existing $dest to $backup/dotfiles (nothing was deleted)."
      set -x
    fi
    if ! mv -T -- "$fresh" "$dest"; then
      if [[ "$existing" == move ]] && mv -T -- "$backup/dotfiles" "$dest"; then
        _die "cannot move the new clone into place; $dest was put back."
      fi
      _die "cannot move the new clone into place."
    fi
    _pending_clone=""
  fi

  cd "$dest"
  if [[ -n "$tty_in" ]]; then
    python3 install.py "$@" < "$tty_in"
  else
    python3 install.py "$@" < /dev/null
  fi

  { set +x; } 2> /dev/null
  echo "All Done!"

  # Only reached when install.py succeeded (set -e stops at a failure).
  _exec_new_shell "$@"
}

# Replace this script with a login shell on the terminal, as oh-my-zsh's
# installer does, so the terminal that ran the one-liner is on the new setup
# at once. The shell is zsh from PATH, else the login shell from passwd
# (getent), e.g. when zsh landed where the pre-install PATH does not reach.
# Only with a terminal (/dev/tty readable and writable, stdout a terminal:
# not under a test harness, cron or a captured run), never for --help, and
# never with DOTFILES_EXEC_SHELL=0. A failed exec ends the script with
# status 0 (the install itself succeeded).
_exec_new_shell() {
  local arg shell_bin
  [[ "${DOTFILES_EXEC_SHELL:-1}" != 0 ]] || return 0
  for arg in "$@"; do
    case "$arg" in -h | --help) return 0 ;; esac
  done
  { : < /dev/tty > /dev/tty; } 2> /dev/null || return 0
  [[ -t 1 ]] || return 0
  shell_bin="$(command -v zsh 2> /dev/null || true)"
  if [[ "$shell_bin" != /* ]]; then
    shell_bin="$(getent passwd "$(id -u)" 2> /dev/null | cut -d: -f7 || true)"
  fi
  [[ "$shell_bin" == /* && -f "$shell_bin" && -x "$shell_bin" ]] || return 0
  case "${shell_bin##*/}" in nologin | false | true) return 0 ;; esac
  echo "Starting a new ${shell_bin##*/} with the new setup."
  # set -e would end the script on a failed exec even with execfail.
  set +e
  shopt -s execfail
  exec "$shell_bin" -l < /dev/tty
  # A failed exec keeps its redirection: stdin is now the terminal, and
  # 'bash -s' would read the rest of its script from there. Stop here.
  echo "could not start ${shell_bin}" >&2
  exit 0
}

# Remove the temporary sibling clone (only ever a path this run created).
_discard_pending_clone() {
  local fresh="${_pending_clone:-}"
  _pending_clone=""
  if [[ -n "$fresh" && "$fresh" == "${HOME}"/.*.new-* && ( -e "$fresh" || -L "$fresh" ) ]]; then
    rm -rf -- "$fresh"
  fi
}

# Suffix for error messages: say that an existing checkout was not touched.
_left_alone() {
  if [[ -e "$1" || -L "$1" ]]; then printf ' %s was left as it was.' "$1"; fi
}

# Compare clone URLs loosely: git@github.com:x/y(.git) == https://github.com/x/y
_normalize_url() {
  local url="$1"
  url="${url%/}"
  url="${url%.git}"
  url="${url#ssh://}"
  case "$url" in
    git@github.com:*) url="https://github.com/${url#git@github.com:}" ;;
    git@github.com/*) url="https://github.com/${url#git@github.com/}" ;;
  esac
  printf '%s\n' "$url"
}

main "$@"
