# Start a detached tmux server at desktop login; tmux-continuum then restores
# the last tmux-resurrect snapshot.  Installed as a static file by the
# personal-dotfiles installer (continuum's @continuum-boot never rewrites it).
[Unit]
Description=tmux server with automatic tmux-resurrect restore (detached)
Documentation=man:tmux(1) https://github.com/tmux-plugins/tmux-continuum
# Start once the desktop session is up: GNOME's shell puts WAYLAND_DISPLAY
# and DISPLAY into the user manager before graphical-session.target is
# reached, and the server (and every pane restored at login) inherits them.
# This explicit ordering also replaces the Before= that the target's Wants=
# would otherwise add.  There is deliberately no PartOf=: logging out of the
# desktop does not stop the server.
After=graphical-session-pre.target graphical-session.target

[Service]
Type=forking
# The graphical environment comes from the user manager (see After= above);
# tmux's update-environment refreshes it for panes created after an attach.
# PATH puts the installer's tools directory (fd shim, fzf-preview.sh) first,
# as zsh/zshenv does, for run-shell and popup commands of this server.
Environment=PATH=%h/.local/share/personal-dotfiles/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Fallback only: tmux-service-start takes DISPLAY, WAYLAND_DISPLAY and the
# Xwayland cookie from the user manager once GNOME has exported them.
Environment=DISPLAY=:0
UnsetEnvironment=TMUX TMUX_PANE TMUX_SERVICE_TMUX TMUX_SERVICE_ENV_POLLS
# A running server with sessions belongs to the user: do not bootstrap again.
ExecCondition=/bin/sh -c '! tmux has-session 2>/dev/null'
# Waits (bounded) for the graphical environment, keeps the Xwayland cookie in
# ~/.Xauthority, then execs `tmux new-session -d -s __continuum_startup`.
ExecStart=%h/.dotfiles/tmux/tmux-service-start
# Save, then stop; the kill runs even if the save fails or is skipped.
ExecStop=-%h/.dotfiles/tmux/resurrect-save
ExecStop=-/usr/bin/env tmux kill-server
KillMode=control-group
TimeoutStartSec=90s
TimeoutStopSec=30s

[Install]
WantedBy=graphical-session.target
