from __future__ import print_function

import sys
sys.dont_write_bytecode = True

import functools
import subprocess
import collections
import json
import os
import os.path
import pwd
import shlex
import stat
import tempfile


def _colors_enabled():
    if 'NO_COLOR' in os.environ:
        return False
    try:
        return sys.stdout.isatty()
    except (AttributeError, ValueError):
        return False


def _wrap_colors(ansicode):
    if not _colors_enabled():
        return (lambda msg: str(msg))
    return (lambda msg: ansicode + str(msg) + '\033[0m')
GRAY   = _wrap_colors("\033[0;37m")
WHITE  = _wrap_colors("\033[1;37m")
RED    = _wrap_colors("\033[0;31m")
GREEN  = _wrap_colors("\033[0;32m")
YELLOW = _wrap_colors("\033[0;33m")
BLUE   = _wrap_colors("\033[0;34m")


_command_args = collections.defaultdict(list)

def add_argument(*args, **kwargs):
    def decorator(func):
        _command_args[func.__name__].append((args, kwargs))

        @functools.wraps(func)
        def f(*args, **kwargs):
            ret = func(*args, **kwargs)
            return ret
        return f
    return decorator

###############################################################################################

GITHUB_URL = "https://github.com/leekyungmoon/dotfiles"

# `update` exit code when the update and install succeeded but the stashed
# local edits could not be re-applied (they stay in the stash).
STASH_CONFLICT_RC = 3


def _dotfiles_dir():
    return os.path.expanduser('~/.dotfiles')


def _python():
    return sys.executable or 'python3'


def _installer(*args):
    '''Delegate to ~/.dotfiles/install.py (bytecode off: nothing lands in the checkout).'''
    dotfiles_dir = _dotfiles_dir()
    return subprocess.call([_python(), '-B', os.path.join(dotfiles_dir, 'install.py')]
                           + list(args), cwd=dotfiles_dir)


def _unknown(argv):
    if argv:
        print(RED('Unknown arguments: ' + ' '.join(argv)))
        return 2
    return 0


@add_argument('--fast', action='store_true', help='Skip all slow updates (zsh/vim plugins)')
@add_argument('--skip-zplug', action='store_true', help='Skip updating zsh plugins (antidote)')
@add_argument('--skip-vimplug', action='store_true', help='Skip updating vim plugins (lazy.nvim)')
@add_argument('--no-packages', action='store_true', help='Skip apt packages and pinned tools')
@add_argument('--no-gui', action='store_true', help='Skip desktop (GNOME) settings')
@add_argument('--no-shell-change', action='store_true', help='Do not run chsh')
def update(fast=False,
           skip_zplug=False,
           skip_vimplug=False,
           no_packages=False,
           no_gui=False,
           no_shell_change=False,
           argv=()):
    '''Update the dotfiles from github.'''

    if _unknown(argv):
        return 2
    dotfiles_dir = _dotfiles_dir()

    def _git_head():
        ret = subprocess.check_output('git rev-parse --short HEAD',
                                      shell=True, cwd=dotfiles_dir)
        if sys.version_info[0] >= 3 and isinstance(ret, bytes):
            ret = ret.decode('utf-8')
        return ret.strip()

    git_old_head = _git_head()

    install_args = []
    if skip_zplug or fast: install_args.append("--skip-zplug")
    if skip_vimplug or fast: install_args.append("--skip-vimplug")
    if no_packages: install_args.append("--no-packages")
    if no_gui: install_args.append("--no-gui")
    if no_shell_change: install_args.append("--no-shell-change")
    install_args = ' '.join(install_args)

    # Tracked local edits are stashed around the fast-forward and put back
    # afterwards (untracked files are left alone); a diverged history is
    # refused by --ff-only rather than merged or reset.
    #
    # Only the stash entry this run created is ever applied or dropped: a
    # push that saves nothing (e.g. only dirty submodule content) still exits
    # 0, so the entry is identified by the stash reflog growing, and it is
    # applied by its commit id, never as "the newest stash". If it cannot be
    # re-applied cleanly the checkout is reset to the updated commit, the
    # entry is kept, and the recovery details go to the status file.
    fd, status_path = tempfile.mkstemp(prefix='update-status-')
    os.close(fd)
    action = r"""#!/bin/bash
        set -e
        set -x
        ret=0
        status_file=%s
        _stash_ids() { if git rev-parse -q --verify refs/stash > /dev/null; then git log -g --format=%%H refs/stash; fi; }
        git fetch origin
        stashed=0
        stash=""
        if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
            before=$(_stash_ids | wc -l)
            git stash push -m "DOTFILES_UPDATE" && stashed=1
            if [ "$(_stash_ids | wc -l)" -gt "$before" ]; then
                stash=$(git rev-parse refs/stash)
            else
                stashed=0
            fi
        fi
        git merge --ff-only && \
            git submodule update --init --recursive && \
            %s -B install.py %s || { ret=$?; }
        { set +x; } 2> /dev/null
        if [ "$stashed" = 1 ]; then
            n=0; found=0
            for id in $(_stash_ids); do
                if [ "$id" = "$stash" ]; then found=1; break; fi
                n=$((n + 1))
            done
            clean=0
            if [ -z "$(git status --porcelain --untracked-files=no --ignore-submodules=all)" ]; then clean=1; fi
            if git stash apply --index -q "$stash"; then
                if [ "$found" = 1 ]; then git stash drop -q "stash@{$n}"; fi
            else
                if [ "$clean" = 1 ]; then git reset --hard -q HEAD; fi
                printf '%%s\n' "$PWD" "$stash" "stash@{$n}" "$clean" > "$status_file"
            fi
        fi
        exit $ret;
    """ % (shlex.quote(status_path), _python(), install_args)

    try:
        ret = subprocess.call(['bash', '-c', action], cwd=dotfiles_dir)
        with open(status_path) as f:
            conflict = f.read().split('\n')
    finally:
        os.unlink(status_path)
    git_new_head = _git_head()

    if ret != 0:
        print(RED('[*] installer has failed. Check the log.'))
    elif git_old_head == git_new_head:
        print(YELLOW('[*] dotfiles is up-to-date ({}).'.format(git_new_head)))
    else:
        print(GREEN('[*] Update complete!'))
        print(WHITE('Changelog: {}..{}'.format(git_old_head, git_new_head)))
        sys.stdout.flush()
        subprocess.call('git log --pretty=oneline --abbrev-commit {}..{}'
                        .format(git_old_head, git_new_head),
                        shell=True, cwd=dotfiles_dir)
    if len(conflict) >= 4:
        checkout, sha, ref, clean = conflict[:4]
        print(RED('[*] Your local edits could not be re-applied on top of {} '
                  '(merge conflict).'.format(git_new_head)))
        if clean == '1':
            print('    {} was reset to {}, so no conflict markers were left behind.'
                  .format(checkout, git_new_head))
        else:
            print('    Check `git status` in {}: conflicted files may contain '
                  'conflict markers.'.format(checkout))
        print('    Your edits are kept, unchanged, in {} ({}).'.format(ref, sha))
        print('    To recover them, resolve the conflicts after:')
        print('      cd {}'.format(shlex.quote(checkout)))
        print('      git stash apply --index {}   # or without --index'.format(sha))
        print('    and once you are done: git stash drop {}'.format(ref))
        sys.stdout.flush()
        if ret == 0:
            ret = STASH_CONFLICT_RC
    return ret


# --- the invoking terminal ----------------------------------------------------
#
# After an update or repair that changed the installed generation, the
# terminal that ran the command must be on the new setup too. A zsh with
# zsh/zsh.d/dotfiles-reload.zsh ("hooked") reloads itself: it is at its
# prompt right after this command, and its precmd hook sees the changed
# generation before that prompt. A shell without the hook (one that predates
# it, or a bash) would stay on the old setup, so this command replaces itself
# with the user's login shell (from passwd, with -l) on the same terminal, as
# etc/install's final exec does. That happens only when all of these hold:
#   - the run succeeded and changed the generation file
#     (${XDG_STATE_HOME:-~/.local/state}/personal-dotfiles/generation): a run
#     that changes nothing starts no shell;
#   - stdin and stdout are this terminal, and this process group is its
#     foreground group (not 'dotfiles update &');
#   - the parent is zsh or bash (comm and exe) on the same terminal, run as
#     an interactive shell (no -c, no operand, also for a '-bash' login
#     argv[0]: 'su - -c CMD' gives '-bash -c CMD');
#   - the parent is not hooked: none of its /proc/<pid>/fd links is the
#     static file ${XDG_STATE_HOME:-~/.local/state}/personal-dotfiles/
#     shell-hook that every hooked zsh keeps open.
# Anything that cannot be read counts against the exec. The new login shell
# runs on top of the parent, which waits for it: run as part of a longer
# command line ('dotfiles update && make') or from a sourced script, the rest
# runs once that shell exits.

_SHELL_NAMES = ('zsh', 'bash')
HOOK_FILE_SUFFIX = '/personal-dotfiles/shell-hook'
GENERATION_MAX_BYTES = 4096
# replaced by the tests
_execvp = os.execvp


def _state_home():
    '''$XDG_STATE_HOME, or ~/.local/state when it is unset or not absolute.'''
    value = os.environ.get('XDG_STATE_HOME', '')
    if not os.path.isabs(value):
        value = os.path.join(os.path.expanduser('~'), '.local', 'state')
    return value


def _shell_hook_file():
    return os.path.join(_state_home(), 'personal-dotfiles', 'shell-hook')


def _read_generation():
    '''The first line of the generation file, or None (missing, unreadable,
    not a regular file, empty); as install.py read_generation.'''
    path = os.path.join(_state_home(), 'personal-dotfiles', 'generation')
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        data = os.read(fd, GENERATION_MAX_BYTES)
    except OSError:
        return None
    finally:
        os.close(fd)
    return data.decode('utf-8', 'replace').split('\n', 1)[0] or None


def _is_hooked(pid, hook_file=None):
    '''pid holds a file descriptor on the shell-hook file: a link that names
    it (or any .../personal-dotfiles/shell-hook, deleted or not, e.g. from a
    shell with another XDG_STATE_HOME), or the same inode. True as well when
    the fd table cannot be read (then there is no exec).'''
    hook_file = hook_file or _shell_hook_file()
    try:
        st_hook = os.stat(hook_file)
        hook_id = (st_hook.st_dev, st_hook.st_ino)
    except OSError:
        hook_id = None
    fd_dir = '/proc/%d/fd' % pid
    try:
        names = os.listdir(fd_dir)
    except OSError:
        return True
    for name in names:
        link = os.path.join(fd_dir, name)
        try:
            target = os.readlink(link)
        except FileNotFoundError:
            continue  # closed since the listing
        except OSError:
            return True
        if target.endswith(' (deleted)'):
            target = target[:-len(' (deleted)')]
        if target == hook_file or target.endswith(HOOK_FILE_SUFFIX):
            return True
        if hook_id is not None and target.startswith('/'):
            try:
                st = os.stat(link)
            except OSError:
                continue
            if (st.st_dev, st.st_ino) == hook_id:
                return True
    return False


# Options that make a shell run commands instead of reading the terminal.
_COMMAND_OPTIONS = ("c",)
_LONG_COMMAND_OPTIONS = ("--command", "--init-command")


def interactive_invocation(argv):
    """Whether a shell's argv is an interactive invocation (kept identical to
    installer/phases.py interactive_invocation; a unit test checks parity).

    Every argument after argv[0] must be an option word (``-l``, ``-il``,
    ``+x``, ``--login``): no ``-c``, no non-option operand such as a script
    file (``bash script.sh``) and no option argument (``--rcfile FILE``,
    ``-o OPT``), which is refused as an operand too. argv[0] starting with
    '-' is how login and tmux start a login shell; that alone is not enough
    (``-zsh -c ...`` is still refused).
    """

    if not argv or not argv[0]:
        return False
    for word in argv[1:]:
        if word in ("-", "--", "+", "++") or not word[:1] in ("-", "+"):
            return False
        if word.startswith("--"):
            name = word.split("=", 1)[0]
            if "=" in word or name in _LONG_COMMAND_OPTIONS or name == "--rcfile":
                return False
            continue
        letters = word[1:]
        if not letters.isalpha() or any(c in letters for c in _COMMAND_OPTIONS):
            return False
        if "o" in letters:  # -o takes the next word
            return False
    return True


def _cmdline(pid):
    with open('/proc/%d/cmdline' % pid, 'rb') as f:
        data = f.read()
    if not data:
        return []
    return data.rstrip(b'\0').decode('utf-8', 'surrogateescape').split('\0')


def _shell_process(pid):
    '''pid runs zsh or bash, by its comm and by its executable.'''
    with open('/proc/%d/comm' % pid) as f:
        comm = f.read().strip()
    exe = os.readlink('/proc/%d/exe' % pid)
    if exe.endswith(' (deleted)'):
        exe = exe[:-len(' (deleted)')]
    return comm in _SHELL_NAMES and os.path.basename(exe) in _SHELL_NAMES


def _same_terminal(pid, tty):
    for fd in (0, 1):
        try:
            if os.path.realpath(os.readlink('/proc/%d/fd/%d' % (pid, fd))) != tty:
                return False
        except OSError:
            return False
    return True


def _login_shell(uid):
    shell = pwd.getpwuid(uid).pw_shell
    if not shell or not os.path.isabs(shell) or not os.access(shell, os.X_OK):
        return None
    if os.path.basename(shell) in ('nologin', 'false', 'true'):
        return None
    return shell


def _refresh_terminal():
    '''Called only after an update or repair that succeeded and changed the
    generation: exec the login shell (-l) on this terminal when the
    conditions above hold. Returns False when nothing was done (and never
    prints anything).'''
    try:
        if not (os.isatty(0) and os.isatty(1)):
            return False
        tty = os.path.realpath(os.ttyname(1))
        if os.path.realpath(os.ttyname(0)) != tty:
            return False
        if os.tcgetpgrp(1) != os.getpgrp():
            return False  # a background job
        ppid = os.getppid()
        if ppid <= 1 or not _shell_process(ppid):
            return False
        if not interactive_invocation(_cmdline(ppid)) or not _same_terminal(ppid, tty):
            return False
        if _is_hooked(ppid):
            return False  # it reloads itself before its next prompt
        shell = _login_shell(os.getuid())
        if shell is None:
            return False
    except (OSError, KeyError, ValueError):
        return False
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        _execvp(shell, [os.path.basename(shell), '-l'])
    except OSError:
        return False
    return True


def open_github(argv=()):
    '''Open the github repository in the web browser.'''

    import webbrowser
    try:
        opened = webbrowser.open(GITHUB_URL, new=0)
    except Exception:
        opened = False
    if not opened:
        print(GITHUB_URL)


def _available_packages():
    '''Pinned tools from manifests/tools.json (installed without sudo).'''
    path = os.path.join(_dotfiles_dir(), 'manifests', 'tools.json')
    try:
        with open(path) as f:
            tools = json.load(f).get('tools', {})
    except (OSError, ValueError, AttributeError):
        return []
    if isinstance(tools, dict):
        return list(tools)
    return [t.get('name') for t in tools if isinstance(t, dict) and t.get('name')]


@add_argument('target', nargs='*', help='pinned tool to install, see ~/.dotfiles/manifests/tools.json for list')
@add_argument('--force', action='store_true')
def install_local(target, force=False, argv=()):
    '''
    Install pinned tools from manifests/tools.json into ~/.local (without sudo).
    Available only in Linux.
    '''

    if not sys.platform.startswith('linux'):
        print("Error: only available on linux systems.")
        sys.exit(1)

    if not isinstance(target, (list, tuple)):
        target = [target]

    packages = _available_packages()
    if not target:
        print("Available packages:")
        print('\n'.join(['- {l}'.format(l=l) for l in packages]))
        return 1
    if _unknown(argv):
        return 2
    unknown = [t for t in target if t not in packages]
    if unknown:
        print(RED('Unknown package(s), nothing was changed: ' + ', '.join(unknown)))
        print('Available packages: ' + ', '.join(packages))
        return 2

    for t in target:
        args = ['packages', '--only', t]
        if force:
            args.append('--force')
        ret = _installer(*args)

        if ret != 0: # error
            return ret

        print(GREEN("\n[*] Installation successful: {}".format(t)))

    print(GREEN("\n\n[*] Installation(s) successful."))


@add_argument('--json', action='store_true', help='Machine-readable output')
def status(json=False, argv=()):
    '''Show the installed generation, last run and drift (install.py status).'''

    if _unknown(argv):
        return 2
    return _installer('status', *(['--json'] if json else []))


@add_argument('--baseline', action='store_true', help='Restore the state before the first install')
@add_argument('--run', metavar='RUN_ID', help='Restore the state before the given run')
@add_argument('-f', '--force', action='store_true', help='Also restore paths changed since the last install')
@add_argument('--id', dest='ids', action='append', metavar='ID', help='Only this managed entry (repeatable)')
def restore(baseline=False, run=None, force=False, ids=None, argv=()):
    '''Restore managed paths from the installer backups (install.py restore).'''

    if _unknown(argv):
        return 2
    args = ['restore']
    if baseline: args.append('--baseline')
    if run: args += ['--run', run]
    if force: args.append('--force')
    for i in ids or []:
        args += ['--id', i]
    return _installer(*args)


@add_argument('--skip-zplug', action='store_true', help='Skip updating zsh plugins')
@add_argument('--skip-vimplug', action='store_true', help='Skip updating vim plugins')
@add_argument('--no-packages', action='store_true', help='Skip apt packages and pinned tools')
@add_argument('--no-gui', action='store_true', help='Skip desktop (GNOME) settings')
@add_argument('--no-shell-change', action='store_true', help='Do not run chsh')
def repair(skip_zplug=False, skip_vimplug=False, no_packages=False, no_gui=False,
           no_shell_change=False, argv=()):
    '''Reapply ~/.dotfiles without pulling (install.py repair).'''

    if _unknown(argv):
        return 2
    args = ['repair']
    if skip_zplug: args.append('--skip-zplug')
    if skip_vimplug: args.append('--skip-vimplug')
    if no_packages: args.append('--no-packages')
    if no_gui: args.append('--no-gui')
    if no_shell_change: args.append('--no-shell-change')
    return _installer(*args)


@add_argument('--autostart', action='store_true', help='Bounded login-time retry mode (used by the autostart entry)')
def gui_apply(autostart=False, argv=()):
    '''Apply pending GNOME settings now (install.py gui-apply).'''

    if _unknown(argv):
        return 2
    return _installer('gui-apply', *(['--autostart'] if autostart else []))


def main():
    COMMANDS = {
        'update': update,
        'github': open_github,
        'install' : install_local,
        'status': status,
        'restore': restore,
        'repair': repair,
        'gui-apply': gui_apply,
    }
    for fn in COMMANDS.values():
        fn.__doc__ = fn.__doc__.strip()

    from argparse import ArgumentParser, RawTextHelpFormatter
    parser = ArgumentParser(description=__doc__,
                            formatter_class=RawTextHelpFormatter)
    subparsers = parser.add_subparsers(title='Available commands',
                                       dest="command")

    for (cmd, action) in COMMANDS.items():
        sp = subparsers.add_parser(cmd, help=action.__doc__)
        for (args, kwargs) in _command_args.get(action.__name__, []):
            sp.add_argument(*args, **kwargs)

    if len(sys.argv) == 1:
        parser.print_help()
        sys.exit(1)
    else:
        args, unknown = parser.parse_known_args()

    kwargs = vars(args)
    command = kwargs.pop('command')
    if command is None:
        parser.print_help()
        sys.exit(1)
    if unknown:
        kwargs['argv'] = unknown
    refresh = command in ('update', 'repair')
    before = _read_generation() if refresh else None
    ret = COMMANDS[command](**kwargs)

    # Only after a run that succeeded and changed the generation: the
    # terminal that ran it gets the new setup too.
    if refresh and not ret:
        after = _read_generation()
        if after is not None and after != before:
            _refresh_terminal()

    if ret:  # non-zero exit code
        sys.exit(ret)



if __name__ == '__main__':
    main()
