{
  "schema_version": 1,
  "description": "Reviewed GNOME navigation settings: window, workspace, monitor and application switching, the explicit Super+arrow tiling unbindings, the Ubuntu Dock click action, the Ctrl+Alt+T terminal launcher, and GNOME Terminal tab/window/paste shortcuts. Values are GVariant text as printed by 'gsettings get'.",
  "defaults_desktop": "ubuntu:GNOME",
  "defaults_desktop_note": "Release defaults below are the ones GLib resolves with XDG_CURRENT_DESKTOP=ubuntu:GNOME (the stock Ubuntu session), because ubuntu-settings and gnome-shell ship desktop-specific overrides. Other desktop names resolve different defaults; the managed values are written either way.",
  "apply_policy": {
    "write": "Every entry is managed: the installer backs up the current per-key state (explicit value or unset) and then writes the manifest value, even when it equals the release default.",
    "unavailable_key": "An entry whose release record says available=false is skipped on that release and recorded as not-applicable; it is never an apply failure.",
    "missing_schema": "An available entry whose schema is not installed yet stays pending until a later session.",
    "unmanaged_keys": "Keys not listed here are never written or reset."
  },
