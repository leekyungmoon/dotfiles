{
  "schema": 1,
  "entries": [
    {
      "id": "bashrc",
      "dest": "{home}/.bashrc",
      "kind": "symlink",
      "source": "bashrc"
    },
    {
      "id": "screenrc",
      "dest": "{home}/.screenrc",
      "kind": "symlink",
      "source": "screenrc"
    },
    {
      "id": "zsh-dir",
      "dest": "{home}/.zsh",
      "kind": "symlink",
      "source": "zsh"
    },
    {
      "id": "zlogin",
      "dest": "{home}/.zlogin",
      "kind": "symlink",
      "source": "zsh/zlogin"
    },
    {
      "id": "zlogout",
      "dest": "{home}/.zlogout",
      "kind": "symlink",
      "source": "zsh/zlogout"
    },
    {
      "id": "zpreztorc",
      "dest": "{home}/.zpreztorc",
      "kind": "symlink",
      "source": "zsh/zpreztorc"
    },
    {
      "id": "zprofile",
      "dest": "{home}/.zprofile",
      "kind": "symlink",
      "source": "zsh/zprofile"
    },
    {
      "id": "zshenv",
      "dest": "{home}/.zshenv",
      "kind": "symlink",
      "source": "zsh/zshenv"
    },
    {
      "id": "zshrc",
      "dest": "{home}/.zshrc",
      "kind": "symlink",
      "source": "zsh/zshrc"
    },
    {
      "id": "vimrc",
      "dest": "{home}/.vimrc",
      "kind": "symlink",
      "source": "vim/vimrc"
    },
    {
      "id": "vim-dir",
      "dest": "{home}/.vim",
      "kind": "symlink",
      "source": "vim"
    },
    {
      "id": "nvim",
      "dest": "{config}/nvim",
      "kind": "symlink",
      "source": "nvim"
    },
    {
      "id": "gitconfig",
      "dest": "{home}/.gitconfig",
      "kind": "copy",
      "source": "git/gitconfig.stub",
      "mode": "0644",
      "description": "a small machine-owned file that includes ~/.dotfiles/git/gitconfig, so 'git config --global' never writes into the checkout"
    },
    {
      "id": "gitignore",
      "dest": "{home}/.gitignore",
      "kind": "symlink",
      "source": "git/gitignore"
    },
    {
      "id": "tmux-conf",
      "dest": "{home}/.tmux.conf",
      "kind": "symlink",
      "source": "tmux/tmux.conf"
    },
    {
      "id": "tmux-dir",
      "dest": "{home}/.tmux",
      "kind": "symlink",
      "source": "tmux"
    },
    {
      "id": "kitty",
      "dest": "{config}/kitty",
      "kind": "symlink",
      "source": "config/kitty"
    },
    {
      "id": "alacritty",
      "dest": "{config}/alacritty",
      "kind": "symlink",
      "source": "config/alacritty"
    },
    {
      "id": "wezterm",
      "dest": "{config}/wezterm",
      "kind": "symlink",
      "source": "config/wezterm"
    },
    {
      "id": "ghostty",
      "dest": "{config}/ghostty",
      "kind": "symlink",
      "source": "config/ghostty"
    },
    {
      "id": "terminator",
      "dest": "{config}/terminator",
      "kind": "symlink",
      "source": "config/terminator",
      "description": "directory link, as upstream: an earlier upstream-style install already has exactly this link"
    },
    {
      "id": "pudb",
      "dest": "{config}/pudb/pudb.cfg",
      "kind": "copy",
      "source": "config/pudb/pudb.cfg",
      "mode": "0644",
      "description": "copied: pudb rewrites its config file"
    },
    {
      "id": "pythonrc",
      "dest": "{home}/.pythonrc.py",
      "kind": "symlink",
      "source": "python/pythonrc.py"
    },
    {
      "id": "pylintrc",
      "dest": "{home}/.pylintrc",
      "kind": "symlink",
      "source": "python/pylintrc"
    },
    {
      "id": "condarc",
      "dest": "{home}/.condarc",
      "kind": "symlink",
      "source": "python/condarc"
    },
    {
      "id": "pycodestyle",
      "dest": "{config}/pycodestyle",
      "kind": "symlink",
      "source": "python/pycodestyle"
    },
    {
      "id": "ptpython",
      "dest": "{config}/ptpython/config.py",
      "kind": "symlink",
      "source": "python/ptpython.config.py"
    },
    {
      "id": "ptpython-legacy",
      "dest": "{home}/.ptpython/config.py",
      "kind": "remove"
    },
    {
      "id": "gtkrc",
      "dest": "{home}/.gtkrc-2.0",
      "kind": "symlink",
      "source": "gtkrc-2.0"
    },
    {
      "id": "xmodmap",
      "dest": "{home}/.Xmodmap",
      "kind": "symlink",
      "source": "Xmodmap"
    },
    {
      "id": "bin-dotfiles",
      "dest": "{home}/.local/bin/dotfiles",
      "kind": "symlink",
      "source": "bin/dotfiles"
    },
    {
      "id": "bin-pbcopy",
      "dest": "{home}/.local/bin/pbcopy",
      "kind": "symlink",
      "source": "bin/pbcopy"
    },
    {
      "id": "bin-pbpaste",
      "dest": "{home}/.local/bin/pbpaste",
      "kind": "symlink",
      "source": "bin/pbpaste"
    },
    {
      "id": "bin-fasd",
      "dest": "{home}/.local/bin/fasd",
      "kind": "symlink",
      "source": "zsh/fasd/fasd"
    },
    {
      "id": "systemd-tmux-service",
      "dest": "{config}/systemd/user/tmux.service",
      "kind": "copy",
      "source": "systemd/user/tmux.service",
      "mode": "0644",
      "condition": "systemd-user"
    },
    {
      "id": "systemd-tmux-service-login-dropin",
      "dest": "{config}/systemd/user/tmux.service.d/login.conf",
      "kind": "remove",
      "description": "obsolete drop-in from an older local setup that would override the shipped tmux.service"
    },
    {
      "id": "systemd-tmux-resurrect-autosave-service",
      "dest": "{config}/systemd/user/tmux-resurrect-autosave.service",
      "kind": "copy",
      "source": "systemd/user/tmux-resurrect-autosave.service",
      "mode": "0644",
      "condition": "systemd-user"
    },
    {
      "id": "systemd-tmux-resurrect-autosave-timer",
      "dest": "{config}/systemd/user/tmux-resurrect-autosave.timer",
      "kind": "copy",
      "source": "systemd/user/tmux-resurrect-autosave.timer",
      "mode": "0644",
      "condition": "systemd-user"
    },
    {
      "id": "systemd-enable-tmux-service",
      "dest": "{config}/systemd/user/graphical-session.target.wants/tmux.service",
      "kind": "link",
      "link_to": "{config}/systemd/user/tmux.service",
      "condition": "systemd-user"
    },
    {
      "id": "systemd-enable-tmux-resurrect-autosave-timer",
      "dest": "{config}/systemd/user/timers.target.wants/tmux-resurrect-autosave.timer",
      "kind": "link",
      "link_to": "{config}/systemd/user/tmux-resurrect-autosave.timer",
      "condition": "systemd-user"
    }
  ]
}
